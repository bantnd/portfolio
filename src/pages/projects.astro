---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { meta, projects } from "../consts.ts";
---

<Layout title={meta.projects.title} description={meta.projects.description}>
  <h2>
    <span class="fancy-highlight">My Projects</span>
  </h2>

  <section class="mt-6 flex flex-col gap-6">
    {
      projects.map((proj) => {
        const href = proj.liveHref || proj.sourceHref || "#";
        const isExternal = href.startsWith("http");
        return (
          <a
            href={href}
            target={isExternal ? "_blank" : "_self"}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="group flex gap-4 p-4 -mx-4 rounded-2xl transition-all duration-200 hover:bg-base-content/[0.04] text-inherit no-underline"
          >
            <div class="w-1/10 flex-shrink-0 pt-1">
              {typeof proj.logoImage === "string" ? (
                <img
                  src={proj.logoImage}
                  alt="Project logo"
                  style={{ transform: `scale(${proj.logoScale ?? 1})` }}
                  class={proj.invertOnDark ? "icon-invert-on-dark" : ""}
                />
              ) : (
                <Image
                  src={proj.logoImage}
                  alt="Project logo"
                  style={{ transform: `scale(${proj.logoScale ?? 1})` }}
                  class={proj.invertOnDark ? "icon-invert-on-dark" : ""}
                />
              )}
            </div>
            <div class="w-9/10">
              <h3 class="transition-colors group-hover:text-accent">
                {proj.title}
              </h3>
              <div class="mt-1 flex flex-wrap gap-1">
                {proj.techs.map((tech) => (
                  <span class="primary-badge">{tech}</span>
                ))}
              </div>
              <p class="text-muted mt-1">{proj.description}</p>
            </div>
          </a>
        );
      })
    }
  </section>
</Layout>
